# Copy to .env.local and fill in your Supabase project values.
# Same values as web/.env.local, just with EXPO_PUBLIC_ prefix.
#
# This app uses a mock/live backend toggle. Provide creds for the control
# project (holds the toggle flag) and the live project. Mock defaults to the
# control project unless you set the optional MOCK_* vars separately.

# Control project — permanently holds the active_backend flag (and acts as mock).
EXPO_PUBLIC_CONTROL_SUPABASE_URL=https://your-control-project.supabase.co
EXPO_PUBLIC_CONTROL_SUPABASE_ANON_KEY=your-control-anon-public-key

# Live project — the real shop.
EXPO_PUBLIC_LIVE_SUPABASE_URL=https://your-live-project.supabase.co
EXPO_PUBLIC_LIVE_SUPABASE_ANON_KEY=your-live-anon-public-key

# Optional: a separate mock project. Defaults to the control project above.
# EXPO_PUBLIC_MOCK_SUPABASE_URL=https://your-mock-project.supabase.co
# EXPO_PUBLIC_MOCK_SUPABASE_ANON_KEY=your-mock-anon-public-key
